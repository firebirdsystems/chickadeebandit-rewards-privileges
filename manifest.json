{
  "id": "rewards-privileges",
  "contexts": ["household", "shared_space"],
  "name": "Rewards",
  "version": "1.1.0",
  "description": "A lightweight motivation layer for kids: adults define redeemable rewards, kids see what they are working toward, and approved redemptions celebrate effort without making every chore about money.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "kids",
    "rewards",
    "motivation",
    "chores",
    "allowance"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "rewards": {"sql": "SELECT * FROM app_rewards_privileges__rewards ORDER BY created_at"},
    "redemption_requests": {"sql": "SELECT * FROM app_rewards_privileges__redemption_requests ORDER BY requested_at DESC"},
    "redemption_decisions": {"sql": "SELECT * FROM app_rewards_privileges__redemption_decisions ORDER BY decided_at DESC"},
    "points_ledger": {"sql": "SELECT member_id, COALESCE(SUM(points), 0) AS earned FROM app_rewards_privileges__points_ledger GROUP BY member_id"},
    "points_rollup": {"sql": "SELECT member_id, points FROM app_rewards_privileges__points_rollup"}
  },
  "db_encryption": "off",
    "member_references": {
      "rewards": {
        "column": "created_by",
        "on_removed": "keep"
      },
      "redemption_requests": {
        "column": "member_id",
        "on_removed": "delete"
      },
      "redemption_decisions": [
        {
          "column": "member_id",
          "on_removed": "delete"
        },
        {
          "column": "decided_by",
          "on_removed": "keep"
        }
      ],
      "points_ledger": {
        "column": "member_id",
        "on_removed": "delete",
        "id_column": "event_id"
      },
      "points_rollup": {
        "column": "member_id",
        "on_removed": "delete",
        "id_column": "rowid"
      }
    },
  "row_policies": {
    "rewards": { "kind": "adult_writable" },
    "redemption_requests": {
      "kind": "owner_only",
      "member_column": "member_id",
      "member_can_update": false
    },
    "redemption_decisions": {
      "kind": "adult_writable",
      "member_read_column": "member_id"
    },
    "points_ledger": {
      "kind": "adult_writable",
      "member_read_column": "member_id",
      "retain_days": {
        "default": 730,
        "timestamp_column": "earned_at",
        "id_column": "event_id",
        "override_key": "points_history",
        "fold": {
          "into_table": "points_rollup",
          "key_columns": { "member_id": "member_id" },
          "sum_columns": { "points": "points" },
          "folded_through_column": "folded_through_at"
        }
      }
    },
    "points_rollup": {
      "kind": "adult_writable",
      "member_read_column": "member_id"
    }
  },
  "publishes": [
    "reward.available",
    "reward.redeemed"
  ],
  "alert_on": [
    "reward.available",
    "reward.redeemed"
  ],
  "publish_acls": {
    "reward.available": { "require_role": "adult" },
    "reward.redeemed": { "require_role": "adult" }
  },
  "automation_actions": {
    "credit_points": {
      "title": "Award reward points",
      "description": "Add points to a member's durable reward-points balance.",
      "params": {
        "member_id": { "type": "member", "label": "Whose points", "required": true },
        "points": { "type": "integer", "label": "Points", "required": true, "min": 1 }
      },
      "dedupe": { "table": "points_ledger", "column": "event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "points_ledger",
          "on_conflict": "ignore",
          "values": {
            "event_id": "$event_id",
            "member_id": ":member_id",
            "points": ":points",
            "earned_at": "$now"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Award points when a chore is completed",
      "description": "Every completed chore adds its point value to the member's reward-points balance. These points persist so kids can save toward bigger rewards.",
      "trigger_event": "chore.completed",
      "trigger_app_id": "chore-tracker",
      "target_app_id": "rewards-privileges",
      "action_id": "credit_points",
      "enable": "automatically",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "member_id" },
        "points": { "kind": "payload_field", "value": "points" }
      }
    }
  ],
  "exports": [
    "reward-catalog",
    "kid-motivation"
  ],
  "nav": { "label": "Rewards" },
  "widget": {
    "label": "Rewards",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🎁"
}
